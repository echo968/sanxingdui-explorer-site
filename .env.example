# DeepSeek is the primary text model. Leave the key blank in the template.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional text-model fallback
ZHIPU_API_KEY=
ZHIPU_TEXT_MODEL=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Optional site-navigation assistant
JEV_API_KEY=
JEV_MODEL=jev-latest

# Digital exhibition workflow credentials
COZE_API_TOKEN=
COZE_WORKFLOW_ID=7700574622361878562

# Local web server and account storage
PORT=4174
SANXINGDUI_ALLOW_REGISTRATION=true
SANXINGDUI_DATABASE_PATH=

# RAG resources. Override these paths on machines with a different layout.
RAG_PDF_DIR=../pdf
RAG_EMBEDDING_MODEL_PATH=../models/bge-m3

# Set SANXINGDUI_INITIAL_USERNAME and SANXINGDUI_INITIAL_PASSWORD only for
# first-run account initialization; README.md shows a secure PowerShell prompt.
