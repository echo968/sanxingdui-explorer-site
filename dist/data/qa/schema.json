{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanxingdui.example/data/qa/schema.json",
  "title": "Sanxingdui research Q&A knowledge records",
  "description": "Short, source-grounded answer units for retrieval. Answers are paraphrases; full copyrighted report text is not stored.",
  "type": "object",
  "required": ["id", "question", "answer", "topic", "answer_kind", "related_context_ids", "related_artifact_ids", "evidence", "caveats", "status", "accessed_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "question": {"type": "string", "minLength": 1},
    "answer": {"type": "string", "minLength": 1},
    "topic": {"type": "string"},
    "answer_kind": {"enum": ["reported_fact", "research_inference", "interpretation", "limitation"]},
    "related_context_ids": {"type": "array", "items": {"type": "string"}},
    "related_artifact_ids": {"type": "array", "items": {"type": "string"}},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "url", "title", "publisher", "locator", "supports"],
        "properties": {
          "source_id": {"type": "string"},
          "url": {"type": "string", "format": "uri"},
          "title": {"type": "string"},
          "publisher": {"type": "string"},
          "published_at": {"type": ["string", "null"]},
          "locator": {"type": "string"},
          "supports": {"type": "array", "items": {"type": "string"}},
          "evidence_note": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "caveats": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["needs_review", "verified", "published"]},
    "accessed_at": {"type": "string", "format": "date"}
  },
  "additionalProperties": false
}
